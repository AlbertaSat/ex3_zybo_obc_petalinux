/include/ "system-conf.dtsi"

/ {
	model = "AlbertaSat Zybo OBC";

	// chosen {
	// 	bootargs = "console=heracles_uart,115200n8 earlycon root=/dev/mmcblk0p2 rw rootwait";
	// 	stdout-path = "serial0:115200n8";
	// };
	
	aliases {
		uhf_rs485_uart = &uart0;
		dfgm_uart = &axi_uartlite_dfgm;
		gps_uart = &axi_uartlite_gps;
		heracles_uart = &axi_uartlite_heracles;
		// uhf_uart = &axi_uartlite_uhf;
		sband_i2c = &axi_iic_sband;
		db_i2c = &i2c1;
		sband_spi = &spi0;
	};
};

// https://stackoverflow.com/questions/53634892/linux-spidev-why-it-shouldnt-be-directly-in-devicetree
// Easiest method is to use "rohm,dh2228fv"
&spi0 {
    spidev@0 {
        symlink = "sband_spi";
        compatible = "rohm,dh2228fv";
        spi-max-frequency = <100000>;
        reg = <0>;
    };
};

&axi_iic_sband {
    symlink = "sband_i2c";
};

&axi_uartlite_dfgm {
    symlink = "dfgm_uart";
    port-number = <0x03>;
};

&axi_uartlite_gps {
    symlink = "gps_uart";
    port-number = <0x02>;
};

&uart0 {
    symlink = "uhf_rs485_uart";
};

&axi_uartlite_heracles {
    symlink = "heracles_uart";
    port-number = <0x01>;
};

&i2c1 {
    symlink = "db_i2c";
    usb2512b@2c {
        compatible = "microchip,usb2512b";
        reg = <0x2c>;
        reset-gpios = <&gpio0 72 1>;
        string-support;
		manufacturer = "AlbertaSat";
		product = "Daedalus Hub";
		serial = "DEADBEEF";
    };
};

&gpio0 {
	gpio-line-names =
		/* Bank 0 */
		"MIO0",
		"MIO1",
		"MIO2",
		"MIO3",
		"MIO4",

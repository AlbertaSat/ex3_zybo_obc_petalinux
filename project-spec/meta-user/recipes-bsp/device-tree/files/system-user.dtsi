/include/ "system-conf.dtsi"
/ {
};

// https://stackoverflow.com/questions/53634892/linux-spidev-why-it-shouldnt-be-directly-in-devicetree
// Easiest method is to use "rohm,dh2228fv"
&sband_spi {
    spidev@0 {
        compatible = "rohm,dh2228fv";
        spi-max-frequency = <100000>;
        reg = <0>;
    };
};

// IRIS SPI needs the userspace IO drivers
&iris_spi {
    compatible = "generic-uio";
};
&dfgm_uart {
    symlink = "dfgm_uart";
};
&ppp_uart_0 {
    symlink = "ppp_uart_0";
};
&ppp_uart_1 {
    symlink = "ppp_uart_1";
};
&ppp_uart_2 {
    symlink = "ppp_uart_2";
};
&ppp_uart_3 {
    symlink = "ppp_uart_3";
};
&sband_iic {
    symlink = "sband_iic";
};
&sband_spi {
    symlink = "sband_spi";
};


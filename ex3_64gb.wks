# Description: Creates a partitioned SD card image. Boot files
# are located in the first vfat partition. Rootfs will be in second ext4 partition.
# G units here are gibibytes
# Real space is 59.6G
# To account for usable space,we leave a 2GB buffer

# part	GB	Gibibytes	        Mibibytes	        Kibibytes (rounded down)
# use   62	57.7419996261597	59127.8076171875	60546875
# hk    3   2.79396772384644	2861.02294921875	2929688
# logs  3   2.79396772384644	2861.02294921875	2929688
# fsw   10	9.31322574615479	9536.7431640625	    9765625
# iris  10	9.31322574615479	9536.7431640625	    9765625
# dfgm  6   5.58793544769287	5722.0458984375	    5859375
# boot  2   1.86264514923096	1907.3486328125	    1953125
# root	28	26.0770320892334	26702.880859375	    27343750
 
part /boot --source bootimg-partition --ondisk mmcblk0 --fstype=vfat --label boot --active --align 4 --fixed-size 1953125K
part / --source rootfs --ondisk mmcblk0 --fstype=ext4 --label root --align 4 --fixed-size 27343750K

# Extended partition with additional storage partitions
# 3GB  -> 2929687.5 kibibytes
# 10GB -> 9765625 kibibytes
# 6GB  -> 5859375 kibibytes
part --ondisk mmcblk0 --fstype=ext4 --label ex3_storage_hk --align 4 --fixed-size 2929688K
part --ondisk mmcblk0 --fstype=ext4 --label ex3_storage_logs --align 4 --fixed-size 2929688K
part --ondisk mmcblk0 --fstype=ext4 --label ex3_storage_fsw --align 4 --fixed-size 9765625K
part --ondisk mmcblk0 --fstype=ext4 --label ex3_storage_iris --align 4 --fixed-size 9765625K
part --ondisk mmcblk0 --fstype=ext4 --label ex3_storage_dfgm --align 4 --fixed-size 5859375K

